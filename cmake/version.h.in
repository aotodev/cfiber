/**
 * @file  version.h
 * @brief Library version, generated by CMake from the project() version.
 */

#ifndef CFIBER_VERSION_H
#define CFIBER_VERSION_H

#define CFIBER_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define CFIBER_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define CFIBER_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define CFIBER_VERSION_STRING "@PROJECT_VERSION@"

/** @brief Single integer for comparisons: major * 10000 + minor * 100 + patch. */
#define CFIBER_VERSION ((CFIBER_VERSION_MAJOR * 10000) + (CFIBER_VERSION_MINOR * 100) + CFIBER_VERSION_PATCH)

#endif /* CFIBER_VERSION_H */
